4305                             								;
4306                             								;
4307                             								;
4308 c8cc 96 49                  		LDAA $49 				; FACTORY TST FMD BYTE 1
4309 c8ce 84 03                  		ANDA #$03 				; b1 & b0,
4310 c8d0 26 0d                  		BNE LC8DF 				; BR IF NOT b0 & b1
4311                             								; ... else
4312 c8d2 ce 00 00               		LDX #$0000 				;
4313 c8d5 86 aa                  		LDAA #$AA 				;
