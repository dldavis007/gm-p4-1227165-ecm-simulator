0118                             		;* Spark param'a, (EST)
0119                             		;* TYPE 32 ECM P/N 122
0120                             		;*******************************************************
0121 c018 0c cd                  LC018: 	FDB 3277 	; Start up RPM
0122 c01a 08                     LC01A: 	FCB 8 		; 12.5 mS LP'S RPM must be up, (8 Lp's)
0123 c01b 20                     LC01B: 	FCB 32 		; If Diff Ld Val > Use Max Dwell
0124 c01c 11                     LC01C: 	FCB 17 		; Advance Ref, (5.9 Deg), (Val/2.844)
0125                             					; Initial advance -- 6 deg
0126 c01d 0d                     LC01D: 	FCB 13 		; 198.28 usec Time Corr to S.A.
0127                             					; - (Val * 15.26) (spark delay)
0128 c01e 00 77                  LC01E: 	FDB 0119 	; 42 DEG Max S.A., (Rel to lead)
0129 c020 ff f5                  LC020: 	FDB 65525 	; 3.5 Deg Max S.A. Retard
0130 c022 00 39                  LC022: 	FDB 57 		; Fixed S.A. For Diag, (20 Deg)
0131 c024 17                     LC024: 	FCB 23 		; 8 Deg Add S.A. for ALDL
0132                             					;
0133                             					; >> STALL SAVER PARAMS <<
0134                             					; NUM = ARG/12.5 For all RPM args
0135                             					;
0136 c025 20                     LC025: 	FCB 32 		; Stall Saver Lo lmt, (400 RPM)
0137 c026 24                     LC026: 	FCB 36 		; Stall Saver Lmt, (450 RPM)
0138 c027 2c                     LC027: 	FCB 44 		; Stall Saver Lmt, (550 RPM)
0139 c028 2c                     LC028: 	FCB 44 		; If RPM > Disable Stall Saver S.A.
0140 c029 02                     LC029: 	FCB 2 		; Add To SABLND ****
0141                             					;
0142                             					; Hot Restart Spark Params
0143                             					;
0144 c02a 71                     LC02A: 	FCB 113 	; If Cool > 54.7C (129 F) DISABLE HOT RESTART,
0145                             					; Num = (temp C +40) * (256/192)
0146                             					;
0147 c02b 1c                     LC02B: 	FCB 28 		; HOT RETARD, (9.8 Deg)
0148                             					; Num = temp * (256/192)
0149                             					;
0150 c02c 71                     LC02C: 	FCB 113 	; DISABLE IF COOL => 54.7c
0151                             					; Num = (temp C +40) * (256/192)
0152                             					;
0153                             					; Disable cold S.A.
0154                             					;
0155 c02d 1b                     LC02D: 	FCB 27 		; If cool diff fm start > 20c
