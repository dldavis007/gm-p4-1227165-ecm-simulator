11853 f1be 0f                     LF1BE: 	SEI 						; Set Int Mask
11854 f1bf 8d 02                  		BSR LF1C3 					; To A/D routine
11855 f1c1 0e                     		CLI 						; Clr int mask, Int's Enabled
11856 f1c2 39                     		RTS 						;
