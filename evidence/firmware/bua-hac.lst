4220 c848 8a 08                  		ORAA #$08 				; Set b3
4221 c84a b7 40 04               		STAA $4004 				; Wr Back
4222                             								;
4223                             								; Serial I/O (SPI) Init
4224                             								;
4225 c84d ce 40 02               		LDX #$4002 				; Output Data Latch
4226 c850 1c 00 04               		BSET 0,X 04	 			; SELECT FMD
4227 c853 86 04                  		LDAA #$04 				; b2, EST ENABLE
4228 c855 97 30                  		STAA $30 				; Save Status to NON VOL RAM
4229 c857 bd f1 f9               		JSR LF1F9 				; Xmit to Serial Data
