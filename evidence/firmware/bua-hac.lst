11909                             		;* Xmit to SPI Data
11910                             		;*
11911                             		;* DATA FROM A Reg LOAD SPI SR AND TRANSMITS
11912                             		;* TO SELECED DEVICE VIA SPI
11913                             		;*
11914                             		;* CALL:
11915                             		;* A = DATA TO BE XMITED VIA SPI
11916                             		;*
11917                             		;* RETURNING:
11918                             		;* A = RX'ED SPI DATA (O IF SPI FAIL)
11919                             		;*
11920                             		;***************************************************
11921 f1f9 3c                     LF1F9: 	PSHX 						; Save X reg
11922 f1fa b7 40 00               		STAA $4000 					; To SPI S/Reg.
11923 f1fd ce 40 01               		LDX #$4001 					;
11924 f200 1d 00 80               		BCLR 0,X $80 				; Clr b7, TO START SPI XMIT
11925                             									;
11926                             									; WAIT FOR SPI TO FINISH, 256 CYC MIN
11927                             									;
11928 f203 86 16                  		LDAA #22 					; TIME DELAY VAL
11929 f205 0c                     		CLC 						; CLR CY, SPI I/O ERR FLG
11930 f206 1e 00 80 06            LF206: 	BRSET 0,X $80 LF210 		; BR IF b7, SPI DONE
11931                             									; ... else
11932 f20a 4a                     		DECA 						; DEC DELAY VALUE
11933 f20b 26 f9                  		BNE LF206 					; BR IF DELAY NOT DONE
11934                             									; ... else
11935 f20d 0d                     		SEC 						;
11936 f20e 20 03                  		BRA LF213 					;
11937                             									;
11938                             									; GET RETURNED DATA FROM SPI
11939                             									;
11940 f210 b6 40 00               LF210: 	LDAA $4000 					; Fm SPI S/Reg
11941 f213 38                     LF213: 	PULX 						;
11942 f214 39                     		RTS 						;
