12321                             		;*******************************************************
12322                             		; MUL16X16
12323                             		; 16 * 16 Mult Fixed Point Routine
12324                             		;
12325                             		; Call with:
12326                             		; X = Multiplicand
12327                             		; A = MSB of Multiplier
12328                             		; B = LSB of Multiplier
12329                             		;
12330                             		; Returns with:
12331                             		; A ACC = Middle 2 bytes of 32 bit product
12332                             		; B ACC = Middle 2 bytes of 32 bit product
12333                             		; X REG = upper 2 bytes of 32 bit result.
12334                             		;
12335                             		; Regesters affected:
12336                             		; A, B, X & Conditions Regester
12337                             		; Execution time = 182 CVycles max
12338                             		;
12339                             		; Middle (A & B) will be set to $FFFF if MSB oof the
12340                             		; result is N.Z.
12341                             		;*******************************************************
12342 f2f0                        		ORG $F2F0
12343 f2f0                        LF2F0: 	
12344 f2f0 36                     		PSHA 					; Reserve for MSB of Result
12345 f2f1 3c                     		PSHX 					; Reserve for Part Result
12346 f2f2 3c                     		PSHX 					; Save Mutlpcand to Stack
12347 f2f3 37                     		PSHB 					; Save LSB of Mult to Stack
12348 f2f4 36                     		PSHA 					; Save MSB of Mult to Stack
12349 f2f5 30                     		TSX 					;
12350 f2f6 a6 03                  		LDAA 3,X 				;
12351 f2f8 3d                     		MUL 					; LSB of Mult'cnd * LSM of Mult
12352 f2f9 89 00                  		ADCA #0 				;
12353 f2fb a7 05                  		STAA 5,X 				;
12354 f2fd ec 01                  		LDD 1,X 				;
12355 f2ff 3d                     		MUL 					; LSB of Mult * MSB of Mult'cnd
12356 f300 eb 05                  		ADDB 5,X 				;
12357 f302 89 00                  		ADCA #0 				;
12358 f304 ed 04                  		STD 4,X 				;
12359 f306 a6 00                  		LDAA 0,X 				; MSB mult'plr X LSB -
12360                             								; Mult'cand
12361 f308 e6 03                  		LDAB 3,X 				;
12362 f30a 6f 06                  		CLR 6,X 				; Clr MSB Of Result
12363 f30c 3d                     		MUL 					; MSB Mult * LSB of Mult'cnd
12364 f30d e3 04                  		ADDD 4,X 				;
12365 f30f 69 06                  		ROL 6,X 				;
12366 f311 ed 04                  		STD 4,X 				;
12367 f313 a6 00                  		LDAA 0,X			
12368 f315 e6 02                  		LDAB 2,X 				;
12369 f317 3d                     		MUL 					; MSB Mult * MSB Mult'cnd
12370 f318 eb 04                  		ADDB 4,X 				; MSB Result In A&B
12371 f31a a9 06                  		ADCA 6,X 				;
12372 f31c e7 04                  		STAB 4,X 				;
12373 f31e ed 02                  		STD 2,X 				; 2 High Bytes to X
12374 f320 4d                     		TSTA 					; Hi Byte N.Z. ?
12375 f321 27 05                  		BEQ LF328 				; If No go
12376                             								; ... else
12377 f323 cc ff ff               		LDD #$FFFF 				; Else Set To $FFFF
12378 f326 ed 04                  		STD 4,X 				;
12379 f328 38                     LF328: 	PULX 					; Higher Bytes to X
12380 f329 38                     		PULX 					;
12381 f32a 32                     		PULA 					; Middle bytes Results to A & B
12382 f32b 33                     		PULB 					;
12383 f32c 31                     		INS 					; Restore Stack
12384 f32d 39                     		RTS
