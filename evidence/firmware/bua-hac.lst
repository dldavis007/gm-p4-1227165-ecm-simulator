12292                             		;*******************************************************
12293 f2d6 3c                     LF2D6: 	PSHX 					;Save X
12294 f2d7 37                     		PSHB 					;Save B
12295 f2d8 36                     		PSHA 					;Vave A
12296 f2d9 10                     		SBA 					;Less than 0 ?
12297 f2da 30                     		TSX 					;
12298 f2db e6 06                  		LDAB 6,X 				;Get Increment Multiplier
12299 f2dd 25 09                  		BCS LF2E8 				;If Cy Set go
12300                             								; ... else
12301                             								;-----------------------------
12302                             								; Interp & rnd Dwn if required
12303                             								;-----------------------------
12304 f2df 3d                     		MUL 					;
12305 f2e0 40                     		NEGA 					;
12306 f2e1 ab 00                  		ADDA 0,X			
12307 f2e3 58                     		ASLB 					;
12308 f2e4 82 00                  		SBCA #0 				;
12309 f2e6 20 04                  		BRA LF2EC 				;
