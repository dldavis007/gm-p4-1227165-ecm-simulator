4207                             								; Clr RAM ?
4208                             								; RAM $01B2 - $002D, 185 BYTES
4209                             								;
4210 c83a ce 01 b2               		LDX #$01B2 				; Last Used RAM Loc
4211 c83d 6f 00                  LC83D: 	CLR 0,X 				; Clear RAM
4212 c83f 09                     		DEX 					; Bump Addr Down
4213 c840 8c 00 2d               		CPX #$002D 				; Done ?
