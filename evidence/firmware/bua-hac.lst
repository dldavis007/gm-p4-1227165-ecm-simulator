11862 f1c5 ce 40 02               		LDX #$4002 					; Point to Serial Data Latch
11863 f1c8 1d 00 08               		BCLR 0,X 08 				; Clr Bit 8
11864 f1cb bd f1 f9               		JSR LF1F9 					; Xmit to Serial Data
11865 f1ce 97 64                  		STAA $64 					; Save to RAM Buffer
11866 f1d0 86 07                  		LDAA #7 					; DELAY VALUE
11867 f1d2 4a                     LF1D2: 	DECA 						;
11868 f1d3 26 fd                  		BNE LF1D2 					; Loop till 0
11869                             									; ... else
