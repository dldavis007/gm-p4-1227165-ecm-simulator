12459                             									; ...else
12460 f377 b6 c1 ea               		LDAA LC1EA 					;
12461 f37a 36                     LF37A: 	PSHA 						;
12462 f37b d6 86                  		LDAB $86 					;F ltered low TPS, (A/D)
12463 f37d 11                     		CBA 						;
12464 f37e 22 0a                  		BHI LF38A 					;
12465                             									; ...else
12466 f380 de 86                  		LDX $86 					; Fltered low TPS, (A/D)
12467 f382 f6 c3 9c               		LDAB LC39C 					; Lo TPS filter coef
12468 f385 bd f2 50               		JSR LF250 					;
12469 f388 dd 86                  		STD $86 					; Fltered low TPS, (A/D)
12470 f38a dc 86                  LF38A: 	LDD $86 					; Fltered low TPS, (A/D)
12471 f38c c3 00 80               		ADDD #$0080 				;
12472 f38f 16                     		TAB 						;
12473 f390 32                     		PULA 						;
12474 f391 10                     		SBA 						;
12475 f392 24 01                  		BCC LF395 					;
12476                             									; ...else
12477 f394 4f                     		CLRA 						;
12478 f395 f6 c3 9a               LF395: 	LDAB LC39A 					; Hi/Lo TPS%
12479 f398 3d                     		MUL 						;
12480 f399 c3 00 20               		ADDD #32 					;
12481 f39c 05                     		ASLD 						;
12482                             									; ...else
12483 f39d 25 03                  		BCS LF3A2 					;
12484                             									; ...else
12485 f39f 05                     		ASLD 						;
12486 f3a0 24 02                  		BCC LF3A4 					;
