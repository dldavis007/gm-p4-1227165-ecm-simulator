4281 c8a7 bd f1 be               		JSR LF1BE 				; To A/D Subroutine
4282 c8aa 81 64                  		CMPA #100 				; 2.0 VDC
4283 c8ac 24 34                  		BCC LC8E2 				; IF GT 2.0 VDC, EXIT via HU CHECK
4284                             								; ... se
