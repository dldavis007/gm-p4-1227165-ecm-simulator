12081                             		;*******************************************************
12082                             		; LKUP3D.src FROM BUA.BIN, 86 VETTE
12083                             		; Main Look Up Subroutine, (3 Dem)
12084                             		;
12085                             		; Enter with:
12086                             		; R = number of rows in table
12087                             		; Q = minimum value of columns
12088                             		; RNUM = Number of Q values, (NUM OF BK POINTS)
12089                             		;
12090                             		; Max Value Diff between talbe entries = 255
12091                             		; Call With:
12092                             		; A = Row Arg
12093                             		; B = Col Arg
12094                             		; X = Tbl Addr
12095                             		;
12096                             		; Returns with:
12097                             		; ACCA = Result, (Y = F(Q,R)
12098                             		;
12099                             		; Regesters affected:
12100                             		; A ACC & Conditions Regester
12101                             		;
12102                             		; Execution time:
12103                             		; 155 CPU Cycles + (2 * p4lkupq+p4lkupr)
12104                             		;
12105                             		; Stack Used:
12106                             		; 11 bytes
12107                             		;
12108                             		; Subs Called:
12109                             		; p4lkupq
12110                             		; p4lkupr
12111                             		;
12112                             		;
12113                             		; $F27C - $F2EF, ($79, 121d BYTES)
12114                             		;
12115                             		;*******************************************************
12116 f27c                        		ORG $F27C
12117 f27c a0 00                  LF27C: 	SUBA 0,X 				; Calc Row Arg offset, (Lmt to 0)
12118 f27e 37                     		PSHB 					; Save Col Arg to stack
12119 f27f 3c                     		PSHX 					; Save Tbl offset to stack
12120 f280 24 01                  		BCC LF283 				; BR IF NO UNDERFLOW
12121                             								; ... else
12122 f282 4f                     		CLRA 					;
12123 f283 e0 01                  LF283: 	SUBB 1,X 				; Calc Col Arg offset, (Lmt to 0)
12124 f285 24 01                  		BCC LF288 				; BR IF NO UNDERFLOW
12125                             								; ... else
12126 f287 5f                     		CLRB 					;
12127 f288 37                     LF288: 	PSHB 					; Save Col Arg to stack
12128 f289 c6 10                  		LDAB #16 				; Make In Arg Into Interp Inc's
12129 f28b 3d                     		MUL 					; Calc Col Arg offset, (Lmt to 0)
12130 f28c 37                     		PSHB 					; Save Interp Inc's tp stack
12131 f28d e6 02                  		LDAB 2,X 				; Set Addr of tbl
12132 f28f 37                     		PSHB 					;
12133 f290 3d                     		MUL 					;
12134 f291 3a                     		ABX 					;
12135 f292 08                     		INX 					;
12136 f293 08                     		INX 					;
12137 f294 08                     		INX 					;
12138 f295 3c                     		PSHX 					; Save Tbl Addr on stack
12139 f296 30                     		TSX 					;
12140                             								;
12141                             								;Call 2d Lk Up, (No Offset)
12142                             								;
12143 f297 a6 04                  		LDAA 4,X 				;Get Col Arg for Lk Up
12144 f299 ee 00                  		LDX 0,X 				;Tbl Addr
12145 f29b bd f2 c6               		JSR LF2C6 				;Call 2d Lk Up, (No Offset)
12146 f29e 36                     		PSHA 					;Save result Of Lk Up to stack
12147 f29f 30                     		TSX 					;
12148 f2a0 a6 05                  		LDAA 5,X 				; Get Col Arg
12149 f2a2 e6 04                  		LDAB 4,X 				;
12150 f2a4 e7 05                  		STAB 5,X 				; Put R(low) in highest STX
12151 f2a6 e6 03                  		LDAB 3,X 				; RNUM
12152 f2a8 ee 01                  		LDX 1,X 				; Addr of Table
12153 f2aa 3a                     		ABX 					; R1 + RNUM
12154 f2ab bd f2 c6               		JSR LF2C6 				; Call 2d Lk Up, (No Offset)
12155 f2ae 16                     		TAB 					;
12156 f2af 32                     		PULA 					;
12157 f2b0 38                     		PULX 					;
12158 f2b1 38                     		PULX 					;
12159 f2b2 bd f2 d6               		JSR LF2D6 				; Call Interpolate routine
12160 f2b5 31                     		INS 					; Restore Stack
12161 f2b6 38                     		PULX 					; Restore X
12162 f2b7 33                     		PULB 					; Restore B
12163 f2b8 39                     		RTS
12164                             		;*******************************************************
12165                             		;--------------------------------------------------
12166                             		;*******************************************************
12167                             		; Look Up Routine 2 dimentional
12168                             		;
12169                             		; Use for tables with 1 byte Unsigned values and
12170                             		; fixed spacing and a 1 byte unsigned Variable
12171                             		;
12172                             		; Four entries are provides, see each for enty & exit
12173                             		; conditions.
12174                             		; Enter with:
12175                             		; FOUR ENTRY POINTS:
12176                             		;
12177                             		; 1. LKUP2D: A ACC = Independent Var Value
12178                             		; B ACC = Offset to be subtracted fm A ACC
12179                             		; prior to table look up
12180                             		;
12181                             		; 2. LKUPQ: A ACC = Independent Var Value, offset=0)
12182                             		; X REG = Address of table
12183                             		;
12184                             		; 3. LKUPR: A ACC = 1st value for interpelation
12185                             		; B ACC = 2nd value for interpelation
12186                             		;
12187                             		; 4. LKUP2C: A ACC = Independent Var Value, offset=0)
12188                             		; X REG = Address of table
12189                             		;
12190                             		; Returns with:
12191                             		; ACC A = Result, (Single byte Un-signed table value)
12192                             		;
12193                             		; Regesters affected:
12194                             		; A ACC & Conditions Regester
12195                             		;
12196                             		; Execution time:
12197                             		; LKUP2D: 128 CPU cycles
12198                             		; LKUPQ: 118
12199                             		; LKUPR: 62
12200                             		; LKUP2C: 126
12201                             		;
12202                             		; Stack Used:
12203                             		; LKUP2D: 10 bytes
12204                             		; LKUPQ: 10 bytes
12205                             		; LKUPR: 4 bytes
12206                             		; LKUP2C 10 bytes
12207                             		;
12208                             		; Subs Called:
12209                             		; None
12210                             		;*******************************************************
12211                             		;*******************************************************
12212                             		;p4lkup2d Entry Point
12213                             		;
12214                             		; Use When an Offset of the Independent Var is in B
12215                             		;
12216                             		; Enter with:
12217                             		; X = Addr of table
12218                             		; A = Independent Var
12219                             		; B = Offset to be sub'ed fm A
12220                             		;
12221                             		; Return with:
12222                             		; A = Results
12223                             		;
12224                             		; 128 Cycles
12225                             		;*******************************************************
12226 f2b9 10                     LF2B9: 	SBA 					;Sub Off set
12227 f2ba 24 0a                  		BCC LF2C6 				;if not L.T. Zero,
12228                             								; - Call 2d Lk Up, (No Offset)
12229                             								; ... else
12230 f2bc 4f                     		CLRA 					;Set To Zero if L.T.
12231 f2bd 20 07                  		BRA LF2C6 				;& go to Lk Up
12232                             								; - Call 2d Lk Up, (No Offset)
12233                             								;--------------------------------------------------
12234                             								;
12235                             								; Use to interpolate fn table with fixed spacing which
12236                             								; is specified in 1st byte of table, No B offset is
12237                             								; allowed.
12238                             								;
12239                             								; Enter with:
12240                             								; X = Addr of table
12241                             								; A = Independent Variable
12242                             								;
12243                             								; Return with:
12244                             								; A = Results
12245                             								;
12246                             								; 126 Cycles
12247                             								;---------------------------------------------------
12248 f2bf 37                     LF2BF: 	PSHB 					; Save B
12249 f2c0 3c                     		PSHX 					; Save Table Addr
12250 f2c1 e6 00                  		LDAB 0,X 				; Get Spacing value
12251 f2c3 08                     		INX 					;
12252 f2c4 20 04                  		BRA LF2CA 				; Goto to Lk Up
12253                             								;----------------------------------------------------------
12254                             								; 2d LK UP, Use When no Offset of the Independent Var.
12255                             								;
12256                             								; Enter with:
