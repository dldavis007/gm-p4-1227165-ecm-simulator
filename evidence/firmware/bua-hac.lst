4296 c8bb cc 40 00               		LDD #$4000 				; LENGTH OF EPROM
4297 c8be bd f3 2e               		JSR LF32E 				; To Ck Sum Subroutine
4298 c8c1 18 ff 01 73            		STY $0173 				; IEEE CK SUM
4299                             								;
4300                             								; INIT IAC & IGN OFF TIMER
4301                             								;
4302 c8c5 86 cc                  		LDAA #204 				;
4303 c8c7 b7 01 79               		STAA $0179 				; IAC MOT
