11899 f1e8 3c                     LF1E8: 	PSHX 						;
11900 f1e9 ce 40 02               		LDX #$4002 					; ENABLE CS FOR FMD
11901 f1ec 1c 00 04               		BSET 0,X 04 				; Set b2
11902 f1ef 96 30                  		LDAA $30 					; SET UP FMD SPI INPUT
11903 f1f1 bd f1 f9               		JSR LF1F9 					; READ SEL FMD BYTES
11904 f1f4 1d 00 04               		BCLR 0,X 04 				; CLR b2, DISABLE FMD
11905 f1f7 38                     		PULX 						;
11906 f1f8 39                     		RTS 						;
