12454 f36c 14 4c 04               		BSET $4C $04 				; SET b2
12455 f36f d7 3f                  LF36F: 	STAB $3F 					;
12456 f371 96 81                  		LDAA $81 					; TPS, (A/D)
12457 f373 c5 24                  		BITB #$24 					; b5 & b2
