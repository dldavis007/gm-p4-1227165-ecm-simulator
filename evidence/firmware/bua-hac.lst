12386                             		;******************************************************
12387                             		;CKSUM:
12388                             		; CALCULATE A STD GM CHECKSUM
12389                             		;
12390                             		; Output is A 16 bit result.
12391                             		; Calling Arg:
12392                             		; B = Number of bytes to cksum
12393                             		; X = Starting address
12394                             		; Returns with:
12395                             		; Y = Checksum
12396                             		;
12397                             		; Execution time:
12398                             		; 855,726 CPU Cycles, (FFFF bytes)
12399                             		;******************************************************
12400 f32e                        		ORG $F32E
12401                             ;		EQU COP $400B 		; Watch dog timer
12402 f32e                        LF32E: 	
12403 f32e 3c                     		PSHX 				; Save start addr of SUM
12404 f32f 37                     		PSHB		
12405 f330 36                     		PSHA 				; Save num of bytes to sum
12406 f331 04                     		LSRD 				; count in 2's
12407 f332 36                     		PSHA 				; save hi byte (/2) on stx
12408 f333 18 ce 00 00            		LDY #0 				; clear Y Reg.
12409 f337 17                     		TBA 				; Ck for ACCB = 0 after shift
12410 f338 27 0e                  		BEQ LF348		
12411                             							;...else
12412 f33a e6 00                  LF33A: 	LDAB 0,X 			;Get byte
12413 f33c 18 3a                  		ABY 				;Add to CHECKSUM
12414 f33e e6 01                  		LDAB 1,X 			;Next byte
12415 f340 18 3a                  		ABY 				;Add to CHECKSUM
12416 f342 c6 02                  		LDAB #2		
12417 f344 3a                     		ABX 				;Point to next pair of bytes
12418 f345 4a                     		DECA 				;Dec counter
12419 f346 26 f2                  		BNE LF33A		
12420                             							; ... else
12421 f348                        LF348: 		
12422 f348 3c                     		PSHX 				; Save current Address
12423 f349 ce ff 00               		LDX #$FF00 			; COP Time Value
12424 f34c ff 40 0b               		STX $400B 			; Toggle COP (every 512 bytes)
12425 f34f 30                     		TSX		
12426 f350 6a 02                  		DEC 2,X 			; Dec hi order byte of count
12427 f352 38                     		PULX 				; Continue till all bytes done
12428 f353 2a e5                  		BPL LF33A		
12429                             							;...else
12430 f355 31                     		INS 				; Dump hi order counter
12431 f356 32                     		PULA 				; Restore regesters
12432 f357 33                     		PULB		
12433 f358 38                     		PULX		
12434 f359 39                     		RTS 				;& Return
