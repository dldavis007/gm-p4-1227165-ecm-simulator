4234                             								; Check Socketed device
4235                             								;
4236 c85f ce c0 08               		LDX #$C008 				;
4237 c862 cc 3f f8               		LDD #$3FF8 				; B Cnt'r Last H.U LF32E 	; To Ck SUM
4238 c865 bd f3 2e               		JSR LF32E				; To CHKSUM
4239 c868 b6 c0 08               		LDAA LC008 				; Get Stored CK SUM
4240 c86b 81 aa                  		CMPA #$AA 				; IF its AN $AA Bypass
4241 c86d 27 0a                  		BEQ LC879 				; Xit & Clr ER #51 Flg
4242                             								; ... else
4243 c86f 81 32                  		CMPA #$32 				; Ck for correct EPROM
4244 c871 26 0b                  		BNE LC87E 				; If Not exit w/error
4245                             								; ... else
4246 c873 18 bc c0 06            		CPY LC006 				; CK CK SUM VAL
4247 c877 26 05                  		BNE LC87E 				; Bad Ck Sum, Xit w/Error
4248                             								; ... else
4249 c879 15 47 10               LC879: 	BCLR $47 $10 			; Clr Er #51 Flg
4250 c87c 20 03                  		BRA LC881 				; Exit Ck Sum test
4251 c87e 14 47 10               LC87E: 	BSET $47 $10 			; Set Err, (#51)
4252 c881 ce fb 1a               LC881: 	LDX #$FB1A 				; Init MPU
4253 c884 13 03 08 03            		BRCLR $03 $08 LC88B 	; Mode Wd3, ERR 51
4254                             								; ... else
4255 c888 ce fb 12               		LDX #$FB12 				; 64,274
4256 c88b ff 3f fc               LC88B: 	STX $3FFC 				; MCU CSR
