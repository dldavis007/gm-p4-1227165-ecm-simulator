12038                             		;* MUL8X16
12039                             		;* 8 X 16 Multiply with 16 bit result.
12040                             		;*
12041                             		;* output is rounded for 16 bit result.
12042                             		;*
12043                             		;* Calling Arg:
12044                             		;* A ACC = 8 BIT Multiplier
12045                             		;* X REG = Address of 16 Bit Multiplicand
12046                             		;*
12047                             		;* Returns with:
12048                             		;* A ACC = MSB of result
12049                             		;* B ACC = LSB 0f result
12050                             		;* Regesters affected:
12051                             		;* A, B & Conditions Regester
12052                             		;* Execution time:
12053                             		;* 68 CPU Cycles
12054                             		;* Stack Used:
12055                             		;* 4 bytes
12056                             		;* Subs Called:
12057                             		;* None
12058                             		;*******************************************************
12059 f266                        		ORG $F266
12060 f266                        LF266: 	
12061 f266 3c                     		PSHX 					; Save mutiplcand on stx
12062 f267 36                     		PSHA 					; save Mult'er on stx
12063 f268 e6 01                  		LDAB 1,X			
12064 f26a 3d                     		MUL 					; Get 1st partial prod
12065 f26b 89 00                  		ADCA #0			
12066 f26d 36                     		PSHA 					; Save partial prod.
12067 f26e a6 00                  		LDAA 0,X			
12068 f270 30                     		TSX			
12069 f271 e6 01                  		LDAB 1,X			
12070 f273 3d                     		MUL 					; Get 2nd Partial prod.
12071 f274 eb 00                  		ADDB 0,X 				; Add 1st part prod to 2nd.
12072 f276 89 00                  		ADCA #0			
12073 f278 38                     		PULX 					; Restore STX
12074 f279 38                     		PULX 					; Get Mutl'cnd to X Reg.
12075 f27a 39                     		RTS 					; & Return
12076                             								;-------------------------------------------------
12077                             								; Throw out Extranious Interupts
12078                             								;-------------------------------------------------
12079 f27b 3b                     		RTI
