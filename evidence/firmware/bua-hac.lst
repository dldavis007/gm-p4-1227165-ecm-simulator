4261 c890 bd f1 be               		JSR LF1BE 				; To A/D
4262 c893 97 7e                  		STAA $7E 				; Batt Volts, (A/D)
4263 c895 81 64                  		CMPA #100 				; 10 VDC
4264 c897 24 49                  		BCC LC8E2 				; IF LT 10 VDC, EXIT via HU CHECK
4265                             								; ... else
4266 c899 14 40 20               		BSET $40 $20 			; set B5, ERR 54A
4267                             								; ... Force Default for Pump Volts
4268                             								;
4269                             								; CK FUEL PUMP VOLTAGE
4270                             								;
