4142                             		;***************************************************
4143                             								;--------------------------------------------------
4144                             								; BIT 0 = SFO
4145                             								; BIT 1 = SF1
4146                             								; SFO SF1 Frq Hz
4147                             								; 0 0 542,288
4148                             								; 1 0 262,144
4149                             								; 0 1 131,072
4150                             								; 1 1 65,536
4151                             								;
4152                             								; BIT 2 = SPO
4153                             								; BIT 3 = SP1
4154                             								; SPO SP1 Frq Hz
4155                             								; 0 0 542,288
4156                             								; 1 0 1,048,576
4157                             								; 0 1 1,572,864
4158                             								; 1 1 2,097,152
4159                             								; BIT 4 =
4160                             								; BIT 5 =
4161                             								;
4162                             								; BIT 6 = 0 = SI,
4163                             								; 1 = PRP for Serial Input
4164                             								;
4165                             								; BIT 7 = Ready Bit
4166                             								; 0 = Init TX/Rx Bits
4167                             								; 1 = Xmiter Ready For Next Byte
4168                             								; Serial Cnt'l set this to 1
4169                             								;
4170 c826 86 8c                  		LDAA #$8C 				; 1000 1100
4171 c828 b7 40 01               		STAA $4001 				; Set Prescaler Serial Port Val
4172                             								;----------------------------------------------------------
4173                             								;----------------------------------------------------------
4174                             								; DDR REGESTER
4175                             								;
4176                             								; 1 = INPUT
4177                             								; 0 = OUTPUT
4178                             								;
4179 c82b 86 8f                  		LDAA #$8F 				; 1000 1111,
4180 c82d b7 40 03               		STAA $4003 				; Set DDR Direction
