0005                             	;* ECM P/N 1227165
0006                             	;*
0007                             	;* MY86 YB L98 MD8 NM8 VE1 G44
0008                             	;*
0009                             	;* GM P4 computer system
0010                             	;*
0011                             	;* Calibration Tables
0012                             	;*
0013                             	;* Deduced fm CAMS Disassembly of EPROM Code
0014                             	;*
0015                             	;* From 1986 Y CAR, (BUA, VETTE)
0016                             	;*
0017                             	;* L98, 8 85 - 86 160 BAUD ONLY
0018                             	;* LB9, F 86 160 BAUD ONLY
0019                             	;*
0020                             	;* LB9, F 87 - 88 160 & 8192 BAUD
0021                             	;* L98, 8 87 - 88 160 & 8192 BAUD
0022                             	;*
0023                             	;* DATA ON PIN E
0024                             	;*
0025                             	;* The ECM is uni-directiona in 160 Baud when the ECM
0026                             	;* is not in the ALDL mode. When the ECM is in the ALDL
0027                             	;* Mode, (10k). The ECM will xmit a normal 25 item ALDL
0028                             	;* list at 160 baud.
0029                             	;*
0030                             	;* The ECM will listen for 50 MSEC after completion of
0031                             	;* the 160 baud ALDL list. for an inboud Test device
0032                             	;* originated 8192 (polling) message.
0033                             	;*
0034                             	;* If the 8192 polling message is accepted, 8192
0035                             	;* commications will continue till power down,
0036                             	;*
0037                             	;*
0038                             	;* CALIB = $C000 - $C800
0039                             	;* IEEE CK SUM =
0040                             	;*
0041                             	;*******************************************************
0042 c000                        		ORG $C000
0043 c000 25 e5                  LC000: 	FDB $25E5 	; EPROM ID code
0044 c002 09 79                  LC002: 	FDB $0979 	; Date Code
0045 c004 02 ee                  LC004: 	FDB $02EE 	; Sequence Number
0046                             					;
0047                             ;LC006: 	FDB $9708 	; Ck Sum of Addr's $C008 - $FFFF (SUM of all bytes)
0048 c006 97 3a                  LC006: 	FDB $973A 	; Ck Sum of Addr's $C008 - $FFFF (SUM of all bytes) C6AE B6 instead of 84
0049 c008 32                     LC008: 	FCB $32 	; Pgm Match Byte, $32 = 1986 Prod.
0050                             					; -Set $AA For bypass of Cksum
0051                             					;
0052 c009 00                     LC009: 	FCB 0 		; Num of Cyl, 8 = 0000 0000, $00
0053                             					; 6 = 1100 0000, $C0
0054                             					; 4 = 1000 0000, $80
0055                             					; 3 = 0110 0000, $60
0056                             					;
0057 c00a ca 21                  LC00A: 	FDB $CA21 	; Cust ID WORD #1
0058 c00c c1 a1                  LC00C: 	FDB $C1A1 	; Cust ID WORD #2
0059                             					;
0060                             					;
0061 c00e 0c cd                  LC00E: 	FDB 3277 	; 66Hz, VATS Ck Value, Fail if VATS L.T.
0062 c010 06 66                  LC010: 	FDB 1638 	; 33hZ, VATS Ck Value, Fail if VATS G.T.
0063                             					;
0064 c012 03 85                  LC012: 	FDB $0385 	; If Ign off => this, turn off MPU
0065                             					;----------------------------------------
0066 c014 b4                     LC014: 	FCB $B4 	; 1011 0100 Air Fuel Opt Word 1, ($B4)
0067                             					;
0068                             					; b7 = Use Filter for Air flow
0069                             					; b6 = Use TCC for Shft Lamp Cnt'l
0070                             					; b5 = Req Clsed Lp for Can Purge
0071                             					; b4 = VATS Enable
0072                             					;
0073                             					; b3 =
0074                             					; b2 = Analog MAF Meter in use (vs FM DIGITAL)
0075                             					; b1 = Single Fire Mode
0076                             					; b0 = Manual Xmission
0077                             					;
0078                             					;----------------------------------------
0079 c015 04                     LC015: 	FCB $04 	; 0000 0100 2nd AIr Flow Mode Word, ($04)
0080                             					;
0081                             					; b7 =
0082                             					; b6 =
0083                             					; b5 =
0084                             					; b4 =
0085                             					;
0086                             					; b3 =
0087                             					; b2 =
0088                             					; b1 = 1 = 2 AIR valves, 0 = 1 valve
0089                             					; b0 =
0090                             					;
0091                             					;----------------------------------------
0092 c016 62                     LC016: 	FCB $62 	; 3rd AIr Flow Mode Word, 0110 0010
0093                             					;
0094                             					; b7 =
0095                             					; b6 = Calc Base Inj PW, not Tbl
0096                             					; b5 = Int Reset when B.Lrn cell Chnge
0097                             					; b4 =
0098                             					;
0099                             					; b3 =
0100                             					; b2 =
0101                             					; b1 = Reset Corr/init of Auto Enrich
0102                             					; b0 =
0103                             					;
0104                             					;----------------------------------------
0105 c017 00                     LC017: 	FCB $00 	; 4th AIr Flow Mode Word, 0000 0000
0106                             					;
0107                             					; b7 = Use TCC out to Cnt'l A/C Clutch
0108                             					; b6 = Use Pwr Steer Pressure Sw
0109                             					; b5 = N.O. Cooling Fan Req input
0110                             					; b4 = TCC lk'ed Hwy Mode Spark Ck On.
0111                             					;
0112                             					; b3 = If CCP Chg, force Int to 128
0113                             					; b2 = 4th Gear Hwy Mode Spark Adv on
0114                             					; b1 =
0115                             					; b0 = Use Ld Val for BLM not dispflow
0116                             					;----------------------------------------
