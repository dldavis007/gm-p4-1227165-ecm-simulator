12266 f2c7 3c                     		PSHX 					; Save Tabl Addr
12267 f2c8 c6 10                  		LDAB #16 				; Set Spacing
12268 f2ca 3d                     LF2CA: 	MUL 					; Calc Increment
12269 f2cb 37                     		PSHB 					; Save Increment on Stack
12270 f2cc 16                     		TAB 					;
12271 f2cd 3a                     		ABX 					;
12272 f2ce ec 00                  		LDD 0,X 				;
12273 f2d0 8d 04                  		BSR LF2D6 				; Call Interpolate routine
12274 f2d2 33                     		PULB 					; Restore Stack
12275 f2d3 38                     		PULX 					;
12276 f2d4 33                     		PULB 					;
12277 f2d5 39                     		RTS 					; Return to Caller
